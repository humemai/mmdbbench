.venv/
site/
__pycache__/
*.pyc
.env
.env.*
!.env.example
.pytest_cache/
log/

# experiments/: the corpora are downloaded or generated by the scripts and are never tracked
experiments/data/
# build_images.sh stages the pinned wheel here and leaves it; the wheels come from PyPI
experiments/docker-wheels/*.whl
# experiments/results is an allowlist: everything under it is raw output and ignored, and the artifacts that are tracked are named here.
# A new tracked artifact needs `git add -f` and a line here. The rule is inverted on purpose: an untracked stray under results/ stops
# `git pull --ff-only` on the benchmark host.
experiments/results/**
!experiments/results/runs_paper.csv
!experiments/results/sparse_cliff.jsonl
!experiments/results/web_benchmarks.json
!experiments/results/e3_q17/
!experiments/results/e3_q17/*.json
!experiments/results/ingest_ab/
!experiments/results/ingest_ab/*.json
!experiments/results/tentag/
!experiments/results/tentag/*.json
!experiments/results/generated/
!experiments/results/generated/**
experiments/results/generated/figures/*.pdf
experiments/results/generated/results_manifest.json
experiments/results/generated/benchmark-results-*.tar.gz

# --- benchmarks/python-bindings ---------------------------------------------
# The binding-level suite (graph/vector/tabular through the Python API, plus
# the Java-vs-Python overhead harness). Same rule as the engine suite beside
# it, stated once here rather than in per-directory .gitignore files: two
# sibling suites with two ignore conventions is how a `results/` blanket in
# one of them ends up silently governing the other.
#
# OUT: append logs, regenerable inputs, and anything a run can rebuild.
# IN:  the frozen rows the paper's numbers are computed from, and the
#      generated tables, so a reader can recompute every cell.
benchmarks/python-bindings/results/runs.jsonl
benchmarks/python-bindings/results/lat/
benchmarks/python-bindings/results/mem/
benchmarks/python-bindings/results/archive_*/
benchmarks/python-bindings/results/*.log
benchmarks/python-bindings/datasets/raw/
benchmarks/python-bindings/datasets/prepared/
# jpype_overhead regenerates its corpora and databases (2.6 GB) from
# gen_dataset.py; only the harness and its result CSVs are tracked.
benchmarks/python-bindings/jpype_overhead/dbs/
benchmarks/python-bindings/jpype_overhead/dbs_*/
benchmarks/python-bindings/jpype_overhead/data_*/
benchmarks/python-bindings/jpype_overhead/results/*.log
benchmarks/python-bindings/jpype_overhead/*.class
